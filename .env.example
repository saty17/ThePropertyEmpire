# === Database (defaults work for local dev) ===
DB_URL=jdbc:postgresql://localhost:5432/property_empire
DB_USERNAME=postgres
DB_PASSWORD=postgres

# === Mail (REQUIRED - no defaults, app won't send emails without these) ===
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# === JWT (has a default, but set your own in production) ===
JWT_SECRET=YourSuperSecretKeyHere

# === Admin seed user (defaults provided) ===
ADMIN_EMAIL=admin@thepropertyempire.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=TPE Admin
